{
  "version": 1,
  "deploymentStatus": "implementation-ready-disabled",
  "repository": "Ironman1421/davidsdailybread",
  "owner": "David Friedhof",
  "runtime": "GitHub Actions ubuntu-latest with pinned Python 3.12 setup",
  "scope": "one canonical X broadcast per newly published edition; no replies, mentions, likes, follows, reposts, quotes, media, or deletion",
  "authority": {
    "contract": "operations/minimum-viable-safety.contract.json",
    "activeCanonicalBroadcasterStandingAuthorized": true,
    "requiresExactLiveEdition": true,
    "requiresImmutableEditionUrl": true,
    "maximumPostsPerEdition": 1,
    "outreachCampaignIncluded": false,
    "repliesIncluded": false,
    "broadcasterMigrationIncluded": false
  },
  "trigger": {
    "workflow": ".github/workflows/ddb-bake.yml",
    "afterJob": "bake",
    "requiresSuccessfulCanonicalPublish": true,
    "inputs": ["date", "slot", "mode"],
    "backfillPostsAllowed": false
  },
  "authorityBoundary": {
    "freshRunner": true,
    "authorJobReceivesXCredentials": false,
    "canonicalPublisherJobReceivesXCredentials": false,
    "broadcastJobPermissions": {
      "actions": "read",
      "contents": "read"
    },
    "environment": "x-broadcast-production",
    "providerInterface": "official X API v2 only"
  },
  "githubSecrets": [
    "X_API_KEY",
    "X_API_SECRET",
    "X_ACCESS_TOKEN",
    "X_ACCESS_TOKEN_SECRET"
  ],
  "githubVariables": [
    "DDB_X_BROADCAST_ENABLED",
    "DDB_X_BROADCAST_KILL_SWITCH",
    "X_EXPECTED_USER_ID",
    "X_EXPECTED_USERNAME"
  ],
  "provisioning": {
    "xDeveloperAppReportedExisting": true,
    "xDeveloperAppPermissionsVerified": false,
    "xAccountIdentityVerified": false,
    "githubEnvironmentCreated": true,
    "githubEnvironmentBranchPolicy": "selected-branch:main",
    "githubEnvironmentSecretsInstalled": false,
    "configuredEnabledValue": "false",
    "configuredKillSwitchValue": "true"
  },
  "enablement": {
    "killSwitchDefaultOn": true,
    "liveRequiresExactEnabledValue": "true",
    "liveRequiresExactKillSwitchValue": "false",
    "secretsLoadedOnlyByLiveStep": true,
    "dryRunRequiresEnabledValue": "false",
    "dryRunRequiresKillSwitchValue": "false",
    "oneEditionCanaryResetsKillSwitchFirst": true,
    "oneEditionCanaryResetsEnabledSecond": true,
    "continuousActivationRequiresSeparateApproval": true
  },
  "providerEndpoints": [
    "GET https://api.x.com/2/users/me",
    "GET https://api.x.com/2/users/{id}/tweets",
    "POST https://api.x.com/2/tweets",
    "GET https://api.x.com/2/tweets/{id}"
  ],
  "idempotency": {
    "key": "ddb:x:canonical:{editionId}:v1",
    "localBootstrap": "distribution/x-broadcast-state.json",
    "durablePreMutationReservationArtifactName": "x-broadcast-reservation-{editionId}",
    "reservationUploadMustSucceedBeforeSecretsLoad": true,
    "durableReceiptArtifactName": "x-broadcast-receipt-{editionId}",
    "duplicateArtifactLookup": "GitHub Actions receipt and reservation artifact metadata API",
    "workflowConcurrency": "ddb-main-writers",
    "ambiguousMutationBlocksRetry": true,
    "providerTimelineDuplicatePreflight": {
      "maximumOriginalPosts": 100,
      "matchesAuthorTextAndExpandedCanonicalUrl": true
    },
    "artifactRetentionDays": 90,
    "historicalDuplicateBackstop": "successful bakes refuse existing edition files"
  },
  "retry": {
    "maximumAttempts": 3,
    "jitter": true,
    "maximumSleepSeconds": 30,
    "readOnlyRetryStatuses": [429, 500, 502, 503, 504],
    "createRetryStatuses": [429],
    "neverRetryStatuses": [400, 401, 403, 404],
    "ambiguousPostTimeoutOr5xx": "do not retry; write needs_reconciliation receipt"
  },
  "logging": {
    "secretValuesAllowed": false,
    "authorizationHeadersAllowed": false,
    "providerBodiesStored": false,
    "attemptArtifactName": "x-broadcast-attempt-{editionId}-{runId}-{runAttempt}"
  },
  "measurementPersistence": {
    "permanentLedger": "distribution/ledger.json",
    "schema": "distribution/metrics.schema.json",
    "writePath": "reviewed-pull-request",
    "artifactIsPermanentLedger": false,
    "ledgerFailureAuthorizesProviderRetry": false,
    "snapshotWindowsHours": [24, 168],
    "unknownMetrics": "null-never-zero"
  },
  "failureNotification": "failed Daily bake workflow run in the GitHub Actions UI; repository owner must keep Actions failure notifications enabled"
}
