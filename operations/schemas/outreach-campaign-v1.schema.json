{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davidsdailybread.com/contracts/outreach-campaign-v1.schema.json",
  "title": "David's Daily Bread lean core-proof outreach campaign contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "programItem",
    "owner",
    "approvedDirectionAt",
    "leanCoreProofAmendedAt",
    "campaignMode",
    "readinessWindow",
    "campaignWindow",
    "acquisitionFranchise",
    "returnPathGate",
    "diagnostics",
    "x",
    "deferredChannels",
    "approvals",
    "stopRules",
    "activationRequires",
    "externalActions"
  ],
  "properties": {
    "version": {"const": 1},
    "status": {"enum": ["readiness-active-public-campaign-blocked", "ready-awaiting-exact-activation", "active", "stopped", "complete"]},
    "programItem": {"const": "DDB-PC-028"},
    "owner": {"const": "David Friedhof"},
    "approvedDirectionAt": {"type": "string", "format": "date-time"},
    "leanCoreProofAmendedAt": {"type": "string", "format": "date-time"},
    "campaignMode": {"const": "lean-core-proof"},
    "readinessWindow": {"$ref": "#/$defs/readinessWindow"},
    "campaignWindow": {"$ref": "#/$defs/campaignWindow"},
    "acquisitionFranchise": {"$ref": "#/$defs/acquisitionFranchise"},
    "returnPathGate": {"$ref": "#/$defs/returnPathGate"},
    "diagnostics": {"$ref": "#/$defs/diagnostics"},
    "x": {"$ref": "#/$defs/x"},
    "deferredChannels": {"$ref": "#/$defs/deferredChannels"},
    "approvals": {"$ref": "#/$defs/approvals"},
    "stopRules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "activationRequires": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "externalActions": {"$ref": "#/$defs/externalActions"}
  },
  "$defs": {
    "readinessWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "mustCompleteBy", "maximumElapsedHours", "cashBudgetUsd"],
      "properties": {
        "startedAt": {"type": "string", "format": "date-time"},
        "mustCompleteBy": {"type": "string", "format": "date-time"},
        "maximumElapsedHours": {"const": 48},
        "cashBudgetUsd": {"const": 0}
      }
    },
    "campaignWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "durationCalendarDays", "startsAt", "endsAt", "activationReceipt"],
      "properties": {
        "status": {"enum": ["not_started", "active", "stopped", "complete"]},
        "durationCalendarDays": {"const": 30},
        "startsAt": {"type": ["string", "null"], "format": "date-time"},
        "endsAt": {"type": ["string", "null"], "format": "date-time"},
        "activationReceipt": {"type": ["string", "null"]}
      }
    },
    "acquisitionFranchise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "eligibleEditionSlot", "sourceCardType", "exactImmutableEditionUrlRequired", "morningSourceCardsAuthorized"],
      "properties": {
        "id": {"const": "evening-field-guide"},
        "priority": {"const": "primary"},
        "eligibleEditionSlot": {"const": "evening"},
        "sourceCardType": {"const": "edition-derived-x-source-card"},
        "exactImmutableEditionUrlRequired": {"const": true},
        "morningSourceCardsAuthorized": {"const": false}
      }
    },
    "returnPathGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "selectedPath", "observable", "implementationReceipt", "validationReceipt", "requiredBeforeCampaignClockStarts", "disallowedSubstitutes", "privacyBoundary"],
      "properties": {
        "status": {"enum": ["blocked-pending-privacy-safe-observable-path", "ready"]},
        "selectedPath": {"type": ["string", "null"]},
        "observable": {"type": "boolean"},
        "implementationReceipt": {"type": ["string", "null"]},
        "validationReceipt": {"type": ["string", "null"]},
        "requiredBeforeCampaignClockStarts": {"const": true},
        "disallowedSubstitutes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "privacyBoundary": {"$ref": "#/$defs/returnPrivacy"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ready"}}, "required": ["status"]},
          "then": {
            "properties": {
              "selectedPath": {"type": "string", "minLength": 1},
              "observable": {"const": true},
              "implementationReceipt": {"type": "string", "minLength": 1},
              "validationReceipt": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "returnPrivacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emailActivated", "analyticsActivated", "communityFeatureActivated", "personalDataCollected", "rawIpStored", "fingerprintingUsed", "crossSiteTrackingUsed"],
      "properties": {
        "emailActivated": {"const": false},
        "analyticsActivated": {"const": false},
        "communityFeatureActivated": {"const": false},
        "personalDataCollected": {"const": false},
        "rawIpStored": {"const": false},
        "fingerprintingUsed": {"const": false},
        "crossSiteTrackingUsed": {"const": false}
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "siteInstrumentationActivated", "siteReturnStatus", "officialFirst1000CollectorSeparate", "officialFirst1000CollectorActivated", "personalDataCollected", "availableSignals", "unavailableSignals", "retention", "killSwitch", "removal"],
      "properties": {
        "mode": {"const": "x-native-and-manual-aggregate-fallback"},
        "siteInstrumentationActivated": {"const": false},
        "siteReturnStatus": {"enum": ["unknown", "available"]},
        "officialFirst1000CollectorSeparate": {"const": true},
        "officialFirst1000CollectorActivated": {"const": false},
        "personalDataCollected": {"const": false},
        "availableSignals": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "unavailableSignals": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "retention": {"type": "string", "minLength": 1},
        "killSwitch": {"type": "string", "minLength": 1},
        "removal": {"type": "string", "minLength": 1}
      }
    },
    "x": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "humanOperator", "readinessReceipt", "readinessStatus", "blockers", "canonicalBroadcaster", "broadcasterChangeAuthorized", "sourceCardsPerCalendarDay", "sourceCardRequiresExactApproval", "sourceCardRequiresImmutableEveningEditionUrl", "replyPlanMinimumOnStaffedDay", "replyPlanMaximumOnStaffedDay", "enforcedPublishedReplyCap", "staffedApprovalWindows", "fifthReplyAuthorized", "weekendQuota", "qualityClearingCanProduceZero", "exactParentAndTextApprovalRequired", "manualOfficialUiPostingOnly", "automatedPostingAuthorized", "browserScriptingAuthorized", "scrapingAuthorized", "paidReadAuthorized"],
      "properties": {
        "account": {"const": "@DavidDailyBread"},
        "humanOperator": {"const": "David Friedhof"},
        "readinessReceipt": {"const": "operations/x-outreach-readiness-receipt.json"},
        "readinessStatus": {"enum": ["blocked", "ready"]},
        "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "canonicalBroadcaster": {"const": "Spark daicc-ddb-autopost"},
        "broadcasterChangeAuthorized": {"const": false},
        "sourceCardsPerCalendarDay": {"const": 1},
        "sourceCardRequiresExactApproval": {"const": true},
        "sourceCardRequiresImmutableEveningEditionUrl": {"const": true},
        "replyPlanMinimumOnStaffedDay": {"const": 0},
        "replyPlanMaximumOnStaffedDay": {"const": 4},
        "enforcedPublishedReplyCap": {"const": 4},
        "staffedApprovalWindows": {"const": 2},
        "fifthReplyAuthorized": {"const": false},
        "weekendQuota": {"const": 0},
        "qualityClearingCanProduceZero": {"const": true},
        "exactParentAndTextApprovalRequired": {"const": true},
        "manualOfficialUiPostingOnly": {"const": true},
        "automatedPostingAuthorized": {"const": false},
        "browserScriptingAuthorized": {"const": false},
        "scrapingAuthorized": {"const": false},
        "paidReadAuthorized": {"const": false}
      }
    },
    "deferredChannels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geminiOmni", "youtube", "generatedMediaAuthorized"],
      "properties": {
        "geminiOmni": {"$ref": "#/$defs/deferredGemini"},
        "youtube": {"$ref": "#/$defs/deferredYoutube"},
        "generatedMediaAuthorized": {"const": false}
      }
    },
    "deferredGemini": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "activationGateEligible", "accountOrPlanVerificationAuthorized", "providerUploadAuthorized", "generationAuthorized", "publicationAuthorized"],
      "properties": {
        "status": {"const": "deferred"},
        "activationGateEligible": {"const": false},
        "accountOrPlanVerificationAuthorized": {"const": false},
        "providerUploadAuthorized": {"const": false},
        "generationAuthorized": {"const": false},
        "publicationAuthorized": {"const": false}
      }
    },
    "deferredYoutube": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "activationGateEligible", "accountMutationAuthorized", "uploadAuthorized", "publicationAuthorized"],
      "properties": {
        "status": {"const": "deferred"},
        "activationGateEligible": {"const": false},
        "accountMutationAuthorized": {"const": false},
        "uploadAuthorized": {"const": false},
        "publicationAuthorized": {"const": false}
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exactSourceCardTextAndAssetRequired", "exactReplyParentAndTextRequired", "silenceMeansApproval", "approvalMayBeReusedForChangedItem"],
      "properties": {
        "exactSourceCardTextAndAssetRequired": {"const": true},
        "exactReplyParentAndTextRequired": {"const": true},
        "silenceMeansApproval": {"const": false},
        "approvalMayBeReusedForChangedItem": {"const": false}
      }
    },
    "externalActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicOutreachAuthorized", "emailActivationOrCollectionAuthorized", "analyticsActivationAuthorized", "communityFeatureActivationAuthorized", "xSourceCardAuthorized", "xReplyAuthorized", "generatedMediaAuthorized", "newsletterOperationAuthorized", "provisioningAuthorized", "deploymentAuthorized", "spendAuthorizedUsd"],
      "properties": {
        "publicOutreachAuthorized": {"type": "boolean"},
        "emailActivationOrCollectionAuthorized": {"type": "boolean"},
        "analyticsActivationAuthorized": {"type": "boolean"},
        "communityFeatureActivationAuthorized": {"type": "boolean"},
        "xSourceCardAuthorized": {"type": "boolean"},
        "xReplyAuthorized": {"type": "boolean"},
        "generatedMediaAuthorized": {"type": "boolean"},
        "newsletterOperationAuthorized": {"type": "boolean"},
        "provisioningAuthorized": {"type": "boolean"},
        "deploymentAuthorized": {"type": "boolean"},
        "spendAuthorizedUsd": {"minimum": 0, "type": "number"}
      }
    }
  }
}
