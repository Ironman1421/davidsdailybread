{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davidsdailybread.com/contracts/ddb-reviewed-morning-handoff-v1.schema.json",
  "title": "DDB reviewed morning handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "packetId", "targetEdition", "reviewedAt", "expiresAt",
    "xManagerLedger", "sourceCandidateIds", "mustReviewCandidateIds", "gapCandidateIds", "verification",
    "editorialRule", "decisions", "authority"
  ],
  "properties": {
    "schemaVersion": {"const": "ddb-reviewed-morning-handoff-v1"},
    "packetId": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-morning$"},
    "targetEdition": {"$ref": "#/$defs/targetEdition"},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "xManagerLedger": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "artifactSha256", "generatedAt"],
      "properties": {
        "schemaVersion": {"const": "x-manager-morning-candidate-ledger-v1"},
        "artifactSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "generatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "sourceCandidateIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mustReviewCandidateIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "gapCandidateIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verification": {"$ref": "#/$defs/verification"},
    "editorialRule": {"$ref": "#/$defs/editorialRule"},
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "hold", "reject"],
      "properties": {
        "selected": {"type": "array", "items": {"$ref": "#/$defs/selectedDecision"}},
        "hold": {"type": "array", "items": {"$ref": "#/$defs/nonselectedDecision"}},
        "reject": {"type": "array", "items": {"$ref": "#/$defs/nonselectedDecision"}}
      }
    },
    "authority": {
      "const": {
        "editorialSelectionFinal": true,
        "publicationApproved": false,
        "selectionOwner": "David's Daily Bread",
        "publicationOwner": "existing-bake-workflow"
      }
    }
  },
  "$defs": {
    "targetEdition": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "slot", "timeZone"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "slot": {"const": "morning"},
        "timeZone": {"const": "America/Los_Angeles"}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["independentFromXManager", "gapSweep"],
      "properties": {
        "independentFromXManager": {"const": true},
        "gapSweep": {
          "type": "object", "additionalProperties": false,
          "required": ["technology", "markets", "science"],
          "properties": {
            "technology": {"$ref": "#/$defs/sweep"},
            "markets": {"$ref": "#/$defs/sweep"},
            "science": {"$ref": "#/$defs/sweep"}
          }
        }
      }
    },
    "sweep": {
      "type": "object", "additionalProperties": false,
      "required": ["completed", "maximumSources", "sourcesChecked"],
      "properties": {
        "completed": {"const": true},
        "maximumSources": {"type": "integer", "minimum": 1},
        "sourcesChecked": {"type": "integer", "minimum": 0}
      }
    },
    "editorialRule": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "weights", "gates"],
      "properties": {
        "version": {"const": "morning-editorial-v1"},
        "weights": {"const": {"substance": 0.3, "sourceAuthority": 0.25, "verificationDepth": 0.2, "freshness": 0.15, "readerRelevance": 0.1}},
        "gates": {"const": {"substance": 60, "sourceAuthority": 60, "verificationDepth": 55, "freshness": 45, "readerRelevance": 50, "total": 58}}
      }
    },
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": ["substance", "sourceAuthority", "verificationDepth", "freshness", "readerRelevance", "total", "eligible", "ruleVersion"],
      "properties": {
        "substance": {"type": "integer", "minimum": 0, "maximum": 100},
        "sourceAuthority": {"type": "integer", "minimum": 0, "maximum": 100},
        "verificationDepth": {"type": "integer", "minimum": 0, "maximum": 100},
        "freshness": {"type": "integer", "minimum": 0, "maximum": 100},
        "readerRelevance": {"type": "integer", "minimum": 0, "maximum": 100},
        "total": {"type": "integer", "minimum": 0, "maximum": 100},
        "eligible": {"type": "boolean"},
        "ruleVersion": {"const": "morning-editorial-v1"}
      }
    },
    "decisionBase": {
      "type": "object",
      "required": ["id", "beat", "title", "reason", "decision", "scores", "verifiedSourceUrls"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "beat": {"enum": ["technology", "markets", "science"]},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "reason": {"type": "string", "minLength": 1},
        "decision": {"enum": ["selected", "hold", "reject"]},
        "mustReview": {"type": "boolean"},
        "scores": {"$ref": "#/$defs/scores"},
        "verifiedSourceUrls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}}
      }
    },
    "selectedDecision": {
      "allOf": [
        {"$ref": "#/$defs/decisionBase"},
        {"type": "object", "properties": {"decision": {"const": "selected"}}}
      ]
    },
    "nonselectedDecision": {"allOf": [{"$ref": "#/$defs/decisionBase"}]}
  }
}
