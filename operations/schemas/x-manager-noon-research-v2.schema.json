{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davidsdailybread.com/contracts/x-manager-noon-research-v2.schema.json",
  "title": "X Manager noon advisory research",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "targetEdition",
    "createdAt",
    "producer",
    "researchInputs",
    "candidates",
    "holds",
    "rejections",
    "blockedReasons",
    "authority"
  ],
  "properties": {
    "schemaVersion": {
      "const": "x-manager-noon-research-v2"
    },
    "status": {
      "enum": ["completed", "blocked"]
    },
    "targetEdition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "slot", "timeZone"],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "slot": {
          "const": "evening"
        },
        "timeZone": {
          "const": "America/Los_Angeles"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "X Manager, Tools and Workflows"
    },
    "researchInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xPro", "xRadar", "xMonitor", "primarySourcesChecked"],
      "properties": {
        "xPro": {
          "$ref": "#/$defs/signedInInput"
        },
        "xRadar": {
          "$ref": "#/$defs/signedInInput"
        },
        "xMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used", "observedAt", "newPaidRunTriggered", "context"],
          "properties": {
            "used": {
              "type": "boolean"
            },
            "observedAt": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "newPaidRunTriggered": {
              "type": "boolean"
            },
            "context": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "primarySourcesChecked": {
          "type": "boolean"
        }
      }
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "workflows"],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/candidate"
              },
              {
                "properties": {
                  "section": {
                    "const": "tools"
                  }
                }
              }
            ]
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/candidate"
              },
              {
                "properties": {
                  "section": {
                    "const": "workflows"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "holds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/advisoryDecision"
      }
    },
    "rejections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/advisoryDecision"
      }
    },
    "blockedReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "const": {
        "advisoryOnly": true,
        "verificationRequired": true,
        "publicationApproved": false,
        "maySelectForDdb": false,
        "mayPublish": false,
        "finalSelectionOwner": "David's Daily Bread"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "researchInputs": {
            "properties": {
              "xPro": {
                "properties": {
                  "used": {
                    "const": true
                  },
                  "observedAt": {
                    "type": "string"
                  }
                }
              },
              "xRadar": {
                "properties": {
                  "used": {
                    "const": true
                  },
                  "observedAt": {
                    "type": "string"
                  }
                }
              },
              "xMonitor": {
                "properties": {
                  "used": {
                    "const": true
                  }
                }
              },
              "primarySourcesChecked": {
                "const": true
              }
            }
          },
          "candidates": {
            "properties": {
              "tools": {
                "minItems": 1
              },
              "workflows": {
                "minItems": 1
              }
            }
          },
          "blockedReasons": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "blockedReasons": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "signedInInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "used", "observedAt", "context"],
      "properties": {
        "requested": {
          "const": true
        },
        "used": {
          "type": "boolean"
        },
        "observedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "context": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "editorialScores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leverage",
        "broadApplicability",
        "repeatability",
        "trendStrength",
        "total",
        "shelfEligible",
        "ruleVersion"
      ],
      "properties": {
        "leverage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "broadApplicability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "repeatability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "trendStrength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "shelfEligible": {
          "type": "boolean"
        },
        "ruleVersion": {
          "const": "editorial-fit-v1"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "section",
        "title",
        "summary",
        "primarySourceUrls",
        "xPostUrls",
        "observedAt",
        "action",
        "caveat",
        "uncertainty",
        "editorialScores",
        "verificationStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "enum": ["tools", "workflows"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "primarySourceUrls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://(?!(?:[a-z0-9-]+\\.)*(?:x\\.com|twitter\\.com)(?:/|$))"
          }
        },
        "xPostUrls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://(?:www\\.)?(?:x\\.com|twitter\\.com)/"
          }
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "caveat": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "editorialScores": {
          "$ref": "#/$defs/editorialScores"
        },
        "verificationStatus": {
          "enum": ["primary-source-checked", "needs-ddb-verification"]
        }
      }
    },
    "advisoryDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "title", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "enum": ["tools", "workflows"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
